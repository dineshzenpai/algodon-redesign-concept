PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Database connection
DATABASE_URL=

# Firebase Web app config (public values, served to the browser by Express)
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_web_app_id

# Firebase Admin SDK service account (server only; never use these in js/config.js)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional email notifications when admins change order status
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOW_UNAUTHENTICATED=false

# Used only by scripts/seed-admin.js. Remove ADMIN_PASSWORD after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
