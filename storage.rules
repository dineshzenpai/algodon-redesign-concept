rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    match /products/{path=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null ||
        (request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)')));
    }
    match /categories/{path=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null ||
        (request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)')));
    }
    match /users/{uid}/{path=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && (request.resource == null ||
        (request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)')));
    }
    match /{path=**} { allow read, write: if false; }
  }
}
